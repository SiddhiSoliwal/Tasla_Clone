const iconsSVGContainer = document.querySelector('.tcl-hidden svg');

function replaceIcon(existingIcon, newIcon) {
	const iconsToReplaceUse = document.querySelectorAll(`.page-powerwall .tcl-badge__icon use[href="${existingIcon}"]`);

	if (iconsToReplaceUse) {
		[...iconsToReplaceUse].forEach(iconToReplaceUse => iconToReplaceUse.setAttribute('href', `${newIcon}`));
	}
}

function getNewSymbol({
	path,
	id,
	name,
	fill
}) {
	const iconSymbol = document.createElementNS('http://www.w3.org/2000/svg', 'symbol');
	iconSymbol.setAttribute('id', id);
	iconSymbol.setAttribute('name', name);
	iconSymbol.setAttribute('fill', fill);
	iconSymbol.setAttribute('viewBox', '0 0 24 24');
	iconSymbol.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
	iconSymbol.innerHTML = path;
	
	return iconSymbol;
}

