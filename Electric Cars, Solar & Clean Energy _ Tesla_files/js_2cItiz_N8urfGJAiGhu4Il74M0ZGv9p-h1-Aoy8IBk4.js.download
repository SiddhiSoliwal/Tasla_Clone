// poserwall stack icon
	const tclPowerwallStackSymbol = getNewSymbol({
		path: powerwallStackPath,
		id: 'tcl-badge-powerwall-stack',
		name: 'Powerwall Stack',
		fill: 'white'
	});
	iconsSVGContainer.appendChild(tclPowerwallStackSymbol);

// use energy icon	
	const tclUseEnergySymbol = getNewSymbol({
		path: useEnergyPath,
		id: 'tcl-badge-use-energy',
		name: 'Use Energy',
		fill: 'none'
	});
	iconsSVGContainer.appendChild(tclUseEnergySymbol);
	
	// storm icon
	const tclStormSymbol = getNewSymbol({
		path: stormPath,
		id: 'tcl-badge-storm',
		name: 'Storm',
		fill: 'white'
	});
	iconsSVGContainer.appendChild(tclStormSymbol);
	
	const tclRechargeSymbol = getNewSymbol({
		path: rechargePath,
		id: 'tcl-badge-recharge',
		name: 'Recharge',
		fill: 'white'
	});
	iconsSVGContainer.appendChild(tclRechargeSymbol);
	
	
	
	// replace with existing
	replaceIcon('#tds-icon-dog', '#tcl-badge-powerwall-stack');
	replaceIcon('#tcl-badge-powerwall-power-your-home', '#tcl-badge-use-energy');
	replaceIcon('#tcl-badge-weather', '#tcl-badge-storm');
	replaceIcon('#tcl-badge-powerwall-solar', '#tcl-badge-recharge');
};
